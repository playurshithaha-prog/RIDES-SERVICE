diff --git a/supabase/migrations/20261121000100_bookings.sql b/supabase/migrations/20261121000100_bookings.sql
new file mode 100644
index 0000000..0d2d855
--- /dev/null
+++ b/supabase/migrations/20261121000100_bookings.sql
@@ -0,0 +1,120 @@
+create schema if not exists extensions;
+create extension if not exists postgis with schema extensions;
+
+create table public.ride_landmarks (
+  id text primary key,
+  demo_x integer not null,
+  demo_y integer not null,
+  location extensions.geography(point, 4326) not null
+);
+create index ride_landmarks_location_idx on public.ride_landmarks using gist (location);
+
+insert into public.ride_landmarks (id, demo_x, demo_y, location) values
+  ('port', 70, 23, extensions.st_setsrid(extensions.st_makepoint(-7.6124, 33.5994), 4326)),
+  ('hassan', 22, 30, extensions.st_setsrid(extensions.st_makepoint(-7.6327, 33.6086), 4326)),
+  ('maarif', 49, 72, extensions.st_setsrid(extensions.st_makepoint(-7.6388, 33.5823), 4326)),
+  ('habous', 80, 79, extensions.st_setsrid(extensions.st_makepoint(-7.6067, 33.5768), 4326));
+
+alter table public.ride_landmarks enable row level security;
+revoke all on public.ride_landmarks from public, anon, authenticated;
+
+create table public.passenger_bookings (
+  id uuid primary key default gen_random_uuid(),
+  passenger_id uuid not null references auth.users (id) on delete cascade,
+  request_id uuid not null,
+  pickup_id text not null references public.ride_landmarks (id),
+  dropoff_id text not null references public.ride_landmarks (id),
+  status text not null default 'confirmed' check (status in ('confirmed', 'approaching', 'onboard', 'completed')),
+  estimated_minutes integer not null check (estimated_minutes > 0),
+  base_minor integer not null check (base_minor >= 0),
+  distance_minor integer not null check (distance_minor >= 0),
+  total_minor integer generated always as (base_minor + distance_minor) stored,
+  created_at timestamptz not null default now(),
+  unique (passenger_id, request_id),
+  check (pickup_id <> dropoff_id)
+);
+create index passenger_bookings_history_idx on public.passenger_bookings (passenger_id, created_at desc, id desc);
+
+alter table public.passenger_bookings enable row level security;
+revoke all on public.passenger_bookings from public, anon, authenticated;
+grant select on public.passenger_bookings to authenticated;
+create policy "Passengers read their own bookings"
+  on public.passenger_bookings for select to authenticated
+  using ((select auth.uid()) = passenger_id);
+
+create function public.confirm_demo_booking(p_request_id uuid, p_pickup_id text, p_dropoff_id text)
+returns public.passenger_bookings
+language plpgsql security definer set search_path = ''
+as $$
+declare
+  actor uuid := auth.uid();
+  trip_distance double precision;
+  booking public.passenger_bookings;
+begin
+  if actor is null then
+    raise exception using errcode = '42501', message = 'Sign in required';
+  end if;
+
+  select sqrt(power(p.demo_x - d.demo_x, 2) + power(p.demo_y - d.demo_y, 2))
+    into trip_distance
+    from public.ride_landmarks p, public.ride_landmarks d
+    where p.id = p_pickup_id and d.id = p_dropoff_id and p.id <> d.id;
+  if trip_distance is null or p_request_id is null then
+    raise exception using errcode = '22023', message = 'Invalid demo booking';
+  end if;
+
+  insert into public.passenger_bookings
+    (passenger_id, request_id, pickup_id, dropoff_id, estimated_minutes, base_minor, distance_minor)
+    values (actor, p_request_id, p_pickup_id, p_dropoff_id, ceil(6 + trip_distance / 6)::integer,
+      900, round(trip_distance / 5)::integer * 100)
+    on conflict (passenger_id, request_id) do nothing
+    returning * into booking;
+  if not found then
+    select * into strict booking from public.passenger_bookings
+      where passenger_id = actor and request_id = p_request_id;
+    if booking.pickup_id <> p_pickup_id or booking.dropoff_id <> p_dropoff_id then
+      raise exception using errcode = '22023', message = 'Request already used for a different route';
+    end if;
+  end if;
+  return booking;
+end;
+$$;
+
+create function public.advance_demo_booking(p_booking_id uuid, p_expected_status text)
+returns public.passenger_bookings
+language plpgsql security definer set search_path = ''
+as $$
+declare
+  actor uuid := auth.uid();
+  next_status text := case p_expected_status
+    when 'confirmed' then 'approaching'
+    when 'approaching' then 'onboard'
+    when 'onboard' then 'completed'
+  end;
+  booking public.passenger_bookings;
+begin
+  if actor is null then
+    raise exception using errcode = '42501', message = 'Sign in required';
+  end if;
+  if next_status is null then
+    raise exception using errcode = '22023', message = 'Booking state could not be advanced';
+  end if;
+  update public.passenger_bookings
+    set status = next_status
+    where id = p_booking_id and passenger_id = actor and status = p_expected_status
+    returning * into booking;
+  if not found then
+    select * into booking from public.passenger_bookings
+      where id = p_booking_id and passenger_id = actor and status = next_status;
+    if not found then
+      raise exception using errcode = '22023', message = 'Booking state could not be advanced';
+    end if;
+  end if;
+  return booking;
+end;
+$$;
+
+revoke all on function public.confirm_demo_booking(uuid, text, text) from public, anon, authenticated;
+revoke all on function public.advance_demo_booking(uuid, text) from public, anon, authenticated;
+grant execute on function public.confirm_demo_booking(uuid, text, text) to authenticated;
+grant execute on function public.advance_demo_booking(uuid, text) to authenticated;
diff --git a/supabase/tests/bookings.sql b/supabase/tests/bookings.sql
new file mode 100644
index 0000000..039f066
--- /dev/null
+++ b/supabase/tests/bookings.sql
@@ -0,0 +1,79 @@
+\set ON_ERROR_STOP on
+begin;
+
+insert into auth.users (id) values
+  ('10000000-0000-4000-8000-000000000001'),
+  ('10000000-0000-4000-8000-000000000002');
+
+set local role authenticated;
+select set_config('request.jwt.claim.sub', '10000000-0000-4000-8000-000000000001', true);
+
+do $$
+declare
+  booking public.passenger_bookings;
+  retried public.passenger_bookings;
+begin
+  booking := public.confirm_demo_booking('20000000-0000-4000-8000-000000000001', 'port', 'maarif');
+  retried := public.confirm_demo_booking('20000000-0000-4000-8000-000000000001', 'port', 'maarif');
+  if booking.id is distinct from retried.id or booking.total_minor <> 2000
+    or booking.estimated_minutes <> 15 or (select count(*) from public.passenger_bookings) <> 1 then
+    raise exception 'Unexpected fare, estimate or idempotency result';
+  end if;
+  begin
+    perform public.confirm_demo_booking('20000000-0000-4000-8000-000000000001', 'port', 'hassan');
+    raise exception 'Reused request with a different route';
+  exception when invalid_parameter_value then null;
+  end;
+  begin
+    perform public.confirm_demo_booking('20000000-0000-4000-8000-000000000002', 'port', 'port');
+    raise exception 'Accepted identical stops';
+  exception when invalid_parameter_value then null;
+  end;
+  begin
+    update public.passenger_bookings set base_minor = 0;
+    raise exception 'Direct fare mutation allowed';
+  exception when insufficient_privilege then null;
+  end;
+  retried := public.advance_demo_booking(booking.id, 'confirmed');
+  if retried.status <> 'approaching' then raise exception 'Unexpected state'; end if;
+  retried := public.advance_demo_booking(booking.id, 'confirmed');
+  if retried.status <> 'approaching' then raise exception 'Retry advanced twice'; end if;
+  perform set_config('rideflow.test_booking_id', booking.id::text, true);
+end $$;
+
+select set_config('request.jwt.claim.sub', '10000000-0000-4000-8000-000000000002', true);
+do $$
+declare
+  booking public.passenger_bookings;
+begin
+  if exists (select from public.passenger_bookings) then
+    raise exception 'Second passenger could read the first passenger booking';
+  end if;
+  begin
+    perform public.advance_demo_booking(current_setting('rideflow.test_booking_id')::uuid, 'approaching');
+    raise exception 'Second passenger could advance the first passenger booking';
+  exception when invalid_parameter_value then null;
+  end;
+  booking := public.confirm_demo_booking('20000000-0000-4000-8000-000000000001', 'port', 'maarif');
+  if (select count(*) from public.passenger_bookings) <> 1
+    or booking.id = current_setting('rideflow.test_booking_id')::uuid then
+    raise exception 'Idempotency or visibility is not scoped to the passenger';
+  end if;
+end $$;
+
+set local role anon;
+do $$
+begin
+  begin
+    perform public.confirm_demo_booking('20000000-0000-4000-8000-000000000001', 'port', 'maarif');
+    raise exception 'Anonymous booking creation allowed';
+  exception when insufficient_privilege then null;
+  end;
+  begin
+    perform 1 from public.passenger_bookings;
+    raise exception 'Anonymous booking read allowed';
+  exception when insufficient_privilege then null;
+  end;
+end $$;
+
+rollback;
