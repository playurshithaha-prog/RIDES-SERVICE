diff --git a/src/app.ts b/src/app.ts
new file mode 100644
index 0000000..2a582a4
--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,40 @@
+import Fastify from 'fastify';
+
+export function buildApp(logger = false) {
+  const app = Fastify({
+    logger,
+    ajv: { customOptions: { removeAdditional: false } },
+  });
+
+  app.setErrorHandler((error, request, reply) => {
+    if (typeof error === 'object' && error !== null && 'validation' in error) {
+      return reply.code(400).send({
+        error: { code: 'VALIDATION_ERROR', message: 'Invalid request.' },
+      });
+    }
+
+    const status = typeof error === 'object' && error !== null && 'statusCode' in error
+      ? error.statusCode
+      : undefined;
+    if (typeof status === 'number' && status >= 400 && status < 500) {
+      return reply.code(status).send({
+        error: { code: 'REQUEST_ERROR', message: 'The request could not be processed.' },
+      });
+    }
+
+    request.log.error({ err: error }, 'Unhandled request error');
+    return reply.code(500).send({
+      error: { code: 'INTERNAL_ERROR', message: 'An unexpected error occurred.' },
+    });
+  });
+
+  app.setNotFoundHandler((_request, reply) => reply.code(404).send({
+    error: { code: 'NOT_FOUND', message: 'Route not found.' },
+  }));
+
+  app.get('/health', {
+    schema: { querystring: { type: 'object', additionalProperties: false } },
+  }, async () => ({ status: 'ok' }));
+
+  return app;
+}
diff --git a/src/server.ts b/src/server.ts
new file mode 100644
index 0000000..feb753d
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,15 @@
+import { buildApp } from './app.ts';
+
+const app = buildApp(true);
+
+try {
+  const port = Number(process.env.PORT ?? '3000');
+  if (!Number.isInteger(port) || port < 1 || port > 65535) {
+    throw new Error('PORT must be an integer from 1 through 65535.');
+  }
+  await app.listen({ port, host: process.env.HOST ?? '127.0.0.1' });
+} catch (error) {
+  app.log.error(error);
+  process.exitCode = 1;
+  await app.close();
+}
diff --git a/test/app.test.ts b/test/app.test.ts
new file mode 100644
index 0000000..4ab6d20
--- /dev/null
+++ b/test/app.test.ts
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { buildApp } from '../src/app.ts';
+
+test('health reports that the service is up', async (context) => {
+  const app = buildApp();
+  context.after(() => app.close());
+  const response = await app.inject('/health');
+  assert.equal(response.statusCode, 200);
+  assert.deepEqual(response.json(), { status: 'ok' });
+});
+
+test('invalid query parameters return a structured 400', async (context) => {
+  const app = buildApp();
+  context.after(() => app.close());
+  const response = await app.inject('/health?unknown=yes');
+  assert.equal(response.statusCode, 400);
+  assert.deepEqual(response.json(), {
+    error: { code: 'VALIDATION_ERROR', message: 'Invalid request.' },
+  });
+});
+
+test('unknown routes return a structured 404', async (context) => {
+  const app = buildApp();
+  context.after(() => app.close());
+  const response = await app.inject('/missing');
+  assert.equal(response.statusCode, 404);
+  assert.deepEqual(response.json(), {
+    error: { code: 'NOT_FOUND', message: 'Route not found.' },
+  });
+});
+
+test('unexpected errors return a generic 500', async (context) => {
+  const app = buildApp();
+  context.after(() => app.close());
+  app.get('/failure', async () => { throw new Error('internal detail'); });
+  const response = await app.inject('/failure');
+  assert.equal(response.statusCode, 500);
+  assert.deepEqual(response.json(), {
+    error: { code: 'INTERNAL_ERROR', message: 'An unexpected error occurred.' },
+  });
+});
